# Google Maps API Key
GOOGLE_MAP_API_KEY="your_google_maps_api_key_here"

# Mapbox Access Token (use public token starting with pk., NOT secret key starting with sk.)
MAP_BOX_API_KEY="pk.your_mapbox_public_token_here"

# Meta App ID
META_APP_ID="your_meta_app_id_here"

# AppsFlyer Dev Key
APPSFLYER_DEV_KEY="your_appsflyer_dev_key_here"

# Apple App ID
APPLE_APP_ID="your_apple_app_id_here"

# AdMob Ad Unit IDs (production)
ADMOB_IOS_NATIVE_AD_UNIT_ID="ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx"
ADMOB_IOS_BANNER_AD_UNIT_ID="ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx"
ADMOB_ANDROID_NATIVE_AD_UNIT_ID="ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx"
ADMOB_ANDROID_BANNER_AD_UNIT_ID="ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx"

# Google Maps (Android)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
